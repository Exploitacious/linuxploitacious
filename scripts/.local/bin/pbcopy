#!/bin/bash
input=$(cat)
printf '%s' "$input" | xclip -selection clipboard
[ -z "$input" ] && exit 0

HIST_FILE="${HOME}/.clipboard_history"
encoded=$(printf '%s' "$input" | sed ':a;N;$!ba;s/\n/\\n/g')
echo "$encoded" >> "$HIST_FILE"

lines=$(wc -l < "$HIST_FILE" 2>/dev/null || echo 0)
if [ "$lines" -gt 500 ]; then
  tail -n 500 "$HIST_FILE" > "$HIST_FILE.tmp" && mv "$HIST_FILE.tmp" "$HIST_FILE"
fi
