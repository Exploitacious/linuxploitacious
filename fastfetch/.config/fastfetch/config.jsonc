{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small"
    },
    "display": {
        "separator": ": "
    },
    "modules": [
        "memory",
        {
            "type": "disk",
            "folders": "/"
        },
        "break",
        "uptime",
        "break",
        "localip",
        {
            "type": "command",
            "key": "Public IP",
            "text": "curl -fsS --max-time 3 https://api.ipify.org || echo 'unavailable'"
        },
	"break"
    ]
}
