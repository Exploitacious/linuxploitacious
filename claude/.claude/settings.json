{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 30,
  "env": {
    "DISABLE_AUTO_COMPACT": "0",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5[1m]",
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "10",
    "CLAUDE_CODE_SHELL": "/bin/bash",
    "CLAUDE_CODE_DISABLE_ORG_MEMORY": "1",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Artifact",
      "ArtifactComments",
      "ArtifactData"
    ]
  },
  "model": "claude-opus-5-5[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/session-briefing.sh\" && \"$H/.claude-config/hooks/session-briefing.sh\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/post-compact-resume.sh\" && \"$H/.claude-config/hooks/post-compact-resume.sh\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/handoff-check.sh\" && \"$H/.claude-config/hooks/handoff-check.sh\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/vault-inbox-check.sh\" && \"$H/.claude-config/hooks/vault-inbox-check.sh\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/memory-index.sh\" && \"$H/.claude-config/hooks/memory-index.sh\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/memory-digest.sh\" && \"$H/.claude-config/hooks/memory-digest.sh\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/foreman-context.sh\" && \"$H/.claude-config/hooks/foreman-context.sh\" 2>/dev/null || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/lane-rules.sh\" && \"$H/.claude-config/hooks/lane-rules.sh\" 2>/dev/null || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/session-work-init.sh\" && \"$H/.claude-config/hooks/session-work-init.sh\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/seatpool-notice.sh\" && \"$H/.claude-config/hooks/seatpool-notice.sh\" 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/post-compact-resume.sh\" && \"$H/.claude-config/hooks/post-compact-resume.sh\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/handoff-check.sh\" && \"$H/.claude-config/hooks/handoff-check.sh\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/session-briefing.sh\" && \"$H/.claude-config/hooks/session-briefing.sh\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/memory-digest.sh\" && \"$H/.claude-config/hooks/memory-digest.sh\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/foreman-context.sh\" && \"$H/.claude-config/hooks/foreman-context.sh\" 2>/dev/null || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/lane-rules.sh\" && \"$H/.claude-config/hooks/lane-rules.sh\" 2>/dev/null || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/session-work-init.sh\" && \"$H/.claude-config/hooks/session-work-init.sh\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/seatpool-notice.sh\" && \"$H/.claude-config/hooks/seatpool-notice.sh\" 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/herdr-agent-state.sh\"; test -x \"$H\" && bash \"$H\" session || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/lane-rules.sh\" && \"$H/.claude-config/hooks/lane-rules.sh\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/pre-compact.sh\" && \"$H/.claude-config/hooks/pre-compact.sh\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; [ ! -x \"$H/.claude-config/hooks/secrets-guard.sh\" ] || \"$H/.claude-config/hooks/secrets-guard.sh\" pre",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; [ ! -x \"$H/.claude-config/hooks/git-guard.sh\" ] || \"$H/.claude-config/hooks/git-guard.sh\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Agent|Task|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; [ ! -x \"$H/.claude-config/hooks/review-gate-guard.sh\" ] || \"$H/.claude-config/hooks/review-gate-guard.sh\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; [ ! -x \"$H/.claude-config/hooks/secrets-guard.sh\" ] || \"$H/.claude-config/hooks/secrets-guard.sh\" post"
          }
        ]
      },
      {
        "matcher": "mcp__umbrella-autotask__autotask__ticket_manage",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/time-checkpoint.sh\" && \"$H/.claude-config/hooks/time-checkpoint.sh\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/context-watch.sh\" && \"$H/.claude-config/hooks/context-watch.sh\" posttool 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/context-watch.sh\" && \"$H/.claude-config/hooks/context-watch.sh\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/seatpool-notice.sh\" && \"$H/.claude-config/hooks/seatpool-notice.sh\" 2>/dev/null || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/disk-alert.sh\" && \"$H/.claude-config/hooks/disk-alert.sh\" 2>/dev/null || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/report-lint.sh\" && \"$H/.claude-config/hooks/report-lint.sh\" 2>/dev/null || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/askuser-cancel.sh\" && \"$H/.claude-config/hooks/askuser-cancel.sh\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/context-watch.sh\" && \"$H/.claude-config/hooks/context-watch.sh\" readout 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/skill-hint.sh\" && \"$H/.claude-config/hooks/skill-hint.sh\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/memory-hint.sh\" && \"$H/.claude-config/hooks/memory-hint.sh\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/askuser-cancel.sh\" && \"$H/.claude-config/hooks/askuser-cancel.sh\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$HOME/COWORK\"; [ -d \"$H\" ] || H=\"$HOME/OPS\"; test -x \"$H/.claude-config/hooks/seatpool-notice.sh\" && \"$H/.claude-config/hooks/seatpool-notice.sh\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "disableAgentView": true,
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\"",
    "refreshInterval": 5
  },
  "enabledPlugins": {},
  "spinnerTipsEnabled": false,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-haiku-5-5": {
      "autoCompactWindow": 100000,
      "effortLevel": "xhigh"
    },
    "claude-fable-5-2": {
      "effortLevel": "high"
    },
    "claude-mythos-5-2": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "disableClaudeAiConnectors": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "autoCompactEnabled": true,
  "idleCompaction": false,
  "switchModelsOnFlag": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true
}
