{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 30,
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "75"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-opus-4-7",
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\"",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "autoMemoryEnabled": true,
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "skipAutoPermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "test -x $HOME/COWORK/WORKFORCE/bin/ac-reorient && $HOME/COWORK/WORKFORCE/bin/ac-reorient 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "test -x $HOME/COWORK/.claude-config/hooks/post-compact-resume.sh && $HOME/COWORK/.claude-config/hooks/post-compact-resume.sh 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "test -x $HOME/COWORK/.claude-config/hooks/pre-compact.sh && $HOME/COWORK/.claude-config/hooks/pre-compact.sh 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
